# Copy to .env and fill in. NEVER commit .env

# OmniRoute dashboard login (change this!)
INITIAL_PASSWORD=change-me-now

# Optional Postgres (only used with: docker compose --profile db up -d)
POSTGRES_PASSWORD=change-me-too

# Web search MCP (get a key at tavily.com)
TAVILY_API_KEY=

# Langfuse cloud (optional, free tier at cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
